<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wach Ana 3ziz 3liik? ❤️</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font: Fredoka / Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Fredoka', 'Poppins', sans-serif;
            background: linear-gradient(135deg, #ff758c 0%, #ff7eb3 50%, #764ba2 100%);
            min-height: 100vh;
            overflow-x: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
        }

        /* Glassmorphism Container */
        .glass-card {
            background: rgba(255, 255, 255, 0.25);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 2px solid rgba(255, 255, 255, 0.4);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        }

        /* Ambient Floating Background Hearts */
        .bg-heart {
            position: absolute;
            color: rgba(255, 255, 255, 0.25);
            animation: floatUp 10s infinite linear;
            z-index: 0;
            pointer-events: none;
        }

        @keyframes floatUp {
            0% {
                transform: translateY(100vh) rotate(0deg) scale(0.8);
                opacity: 0;
            }
            20% {
                opacity: 0.8;
            }
            100% {
                transform: translateY(-10vh) rotate(360deg) scale(1.3);
                opacity: 0;
            }
        }

        /* Glowing Pulse Animation */
        @keyframes pulseGlow {
            0%, 100% {
                box-shadow: 0 0 20px rgba(255, 75, 110, 0.6), 0 0 40px rgba(255, 75, 110, 0.4);
            }
            50% {
                box-shadow: 0 0 35px rgba(255, 75, 110, 0.9), 0 0 60px rgba(255, 75, 110, 0.7);
            }
        }

        .pulse-btn {
            animation: pulseGlow 2s infinite;
        }

        /* Custom smooth transition for sizing */
        .smooth-transform {
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        /* Floating Gif / Image bounce */
        .bounce-gentle {
            animation: bounceGentle 2s infinite ease-in-out;
        }

        @keyframes bounceGentle {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
        }
    </style>
</head>
<body class="relative flex flex-col items-center justify-center min-h-screen p-4 select-none">

    <!-- Floating Background Hearts Container -->
    <div id="bg-hearts-container" class="absolute inset-0 overflow-hidden pointer-events-none"></div>

    <!-- Main Card -->
    <main id="main-card" class="glass-card relative z-10 w-full max-w-lg p-6 sm:p-10 rounded-3xl text-center transition-all duration-500 my-auto">
        
        <!-- Top Cute Emoji / Illustration -->
        <div class="flex justify-center mb-4">
            <div id="status-icon" class="text-7xl sm:text-8xl bounce-gentle filter drop-shadow-lg">
                🥺
            </div>
        </div>

        <!-- Question Title -->
        <h1 id="question-text" class="text-3xl sm:text-4xl font-extrabold text-white drop-shadow-md mb-2 leading-tight">
            Wach ana 3ziz 3liik? ❤️
        </h1>

        <!-- Playful Dynamic Subtitle -->
        <p id="sub-text" class="text-pink-100 font-semibold text-lg sm:text-xl min-h-[32px] mb-8 drop-shadow">
            Khassak tjaweb b saraha... 🙈
        </p>

        <!-- Buttons Container -->
        <div id="buttons-container" class="relative flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 min-h-[160px]">
            
            <!-- YES BUTTON -->
            <button id="yes-btn" onclick="handleYesClick()" 
                class="smooth-transform pulse-btn bg-gradient-to-r from-emerald-400 to-green-500 hover:from-emerald-500 hover:to-green-600 text-white font-black py-4 px-8 rounded-full shadow-xl hover:shadow-2xl flex items-center justify-center gap-2 text-xl cursor-pointer z-20 transform hover:scale-105 active:scale-95">
                <i class="fa-solid fa-heart"></i>
                <span id="yes-text">Iyeh! 😍</span>
            </button>

            <!-- NO BUTTON -->
            <button id="no-btn" onclick="handleNoClick()" onmouseenter="hoverNo()"
                class="smooth-transform bg-gradient-to-r from-rose-500 to-red-600 hover:from-rose-600 hover:to-red-700 text-white font-bold py-4 px-8 rounded-full shadow-lg flex items-center justify-center gap-2 text-xl cursor-pointer z-10 active:scale-90">
                <i class="fa-solid fa-xmark"></i>
                <span id="no-text">Lla 😜</span>
            </button>

        </div>

    </main>

    <!-- Success Celebration Modal / Display (Hidden by default) -->
    <div id="success-screen" class="hidden fixed inset-0 z-50 flex flex-col items-center justify-center bg-black/40 backdrop-blur-md p-4">
        <div class="glass-card max-w-md w-full p-8 rounded-3xl text-center animate-bounce-in text-white relative border-2 border-pink-300/50 shadow-2xl">
            <div class="text-8xl mb-4 animate-bounce">
                🥰
            </div>
            <h2 class="text-4xl font-extrabold text-pink-200 mb-3 drop-shadow-lg">
                Kount 3arefha! 🎉❤️
            </h2>
            <p class="text-xl text-white/90 font-medium mb-6">
                Hta ana 3ziz(a) 3liya bzaaaaf! ✨💖
            </p>
            <div class="flex justify-center gap-3 text-3xl text-pink-300 mb-6">
                <i class="fa-solid fa-heart animate-pulse"></i>
                <i class="fa-solid fa-sparkles animate-spin"></i>
                <i class="fa-solid fa-heart animate-pulse"></i>
            </div>
            <button onclick="resetApp()" class="bg-white/30 hover:bg-white/40 text-white font-bold py-2 px-6 rounded-full border border-white/50 backdrop-blur transition-all active:scale-95">
                3awd mra khorya 🔄
            </button>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // Cute playful messages every time "NO" is clicked or hovered
        const playfulMessages = [
            "Wa3iya shi shwiya? 🤔",
            "Fakar mzyan! 🤨",
            "Wa 3afak... 🥺",
            "Makaynsh Lla hna! 😤",
            "Rak ghadi tndam! 😜",
            "Safi gha dir Iyeh ❤️",
            "Ghir zayd katandghar 😂",
            "Wayli wayli 🙈",
            "Malk 3akssi(a)? 🙄",
            "3arfak katanass! 😉"
        ];

        // Cute emojis changing with NO clicks
        const cuteEmojis = ["🥺", "🧐", "😮", "🫣", "😭", "😤", "😜", "🙈", "💗"];

        let noClickCount = 0;
        let yesScale = 1.0;
        let yesPaddingY = 1; // multiplier
        let yesPaddingX = 2; // multiplier
        let noScale = 1.0;

        const yesBtn = document.getElementById('yes-btn');
        const noBtn = document.getElementById('no-btn');
        const subText = document.getElementById('sub-text');
        const statusIcon = document.getElementById('status-icon');
        const bgHeartsContainer = document.getElementById('bg-hearts-container');

        // Create ambient floating background hearts
        function createBackgroundHearts() {
            const heartIcons = ['❤️', '💖', '💕', '💗', '💓', '✨'];
            for (let i = 0; i < 25; i++) {
                const heart = document.createElement('div');
                heart.className = 'bg-heart';
                heart.innerText = heartIcons[Math.floor(Math.random() * heartIcons.length)];
                heart.style.left = `${Math.random() * 100}%`;
                heart.style.animationDuration = `${6 + Math.random() * 8}s`;
                heart.style.animationDelay = `${Math.random() * 5}s`;
                heart.style.fontSize = `${16 + Math.random() * 28}px`;
                bgHeartsContainer.appendChild(heart);
            }
        }

        // Playful web audio sound effects
        function playTone(freq, duration, type = 'sine') {
            try {
                const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = audioCtx.createOscillator();
                const gain = audioCtx.createGain();
                osc.type = type;
                osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
                gain.gain.setValueAtTime(0.1, audioCtx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + duration);
                osc.connect(gain);
                gain.connect(audioCtx.destination);
                osc.start();
                osc.stop(audioCtx.currentTime + duration);
            } catch(e) {
                // Audio context block fallback
            }
        }

        function playVictorySound() {
            const notes = [261.63, 329.63, 392.00, 523.25, 659.25];
            notes.forEach((freq, idx) => {
                setTimeout(() => playTone(freq, 0.4, 'triangle'), idx * 120);
            });
        }

        // Logic when NO button is clicked or hovered
        function handleNoClick() {
            noClickCount++;
            playTone(200 - (noClickCount * 10), 0.15, 'sawtooth');

            // 1. Grow YES button continuously
            yesScale += 0.35;
            yesBtn.style.transform = `scale(${yesScale})`;

            // 2. Shrink or move NO button
            noScale = Math.max(0.4, noScale - 0.08);
            
            // On higher clicks, jump NO button around
            if (noClickCount >= 3) {
                const randomX = (Math.random() - 0.5) * 180;
                const randomY = (Math.random() - 0.5) * 120;
                noBtn.style.transform = `scale(${noScale}) translate(${randomX}px, ${randomY}px)`;
            } else {
                noBtn.style.transform = `scale(${noScale})`;
            }

            // 3. Update playful texts & emojis
            const msgIndex = (noClickCount - 1) % playfulMessages.length;
            subText.innerText = playfulMessages[msgIndex];

            const emojiIndex = noClickCount % cuteEmojis.length;
            statusIcon.innerText = cuteEmojis[emojiIndex];
        }

        function hoverNo() {
            // Dodge effect after 5 clicks
            if (noClickCount >= 5) {
                handleNoClick();
            }
        }

        // Logic when YES button is clicked
        function handleYesClick() {
            playVictorySound();

            // Fire Confetti Explosion
            confetti({
                particleCount: 120,
                spread: 80,
                origin: { y: 0.6 },
                colors: ['#ff4b6e', '#ff758c', '#ffffff', '#ffd1dc', '#ffb3c1']
            });

            // Extra heart rain effect
            setTimeout(() => {
                confetti({
                    particleCount: 60,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 }
                });
                confetti({
                    particleCount: 60,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 }
                });
            }, 250);

            // Show Success Screen
            document.getElementById('success-screen').classList.remove('hidden');
        }

        // Reset application
        function resetApp() {
            noClickCount = 0;
            yesScale = 1.0;
            noScale = 1.0;

            yesBtn.style.transform = 'scale(1)';
            noBtn.style.transform = 'scale(1)';

            subText.innerText = "Khassak tjaweb b saraha... 🙈";
            statusIcon.innerText = "🥺";

            document.getElementById('success-screen').classList.add('hidden');
        }

        // Initialize on load
        window.onload = function() {
            createBackgroundHearts();
        };
    </script>
</body>
</html>